{
  "name": "sessions-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Search, share, and pull your AI coding-agent sessions (Claude Code, Codex) via a simple MCP server.",
  "type": "module",
  "bin": {
    "sessions-mcp": "dist/sessions-mcp.mjs"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/sessions-mcp.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.23.0"
  }
}